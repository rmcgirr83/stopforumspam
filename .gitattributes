# Normalize line endings to LF in the repository
* text=auto eol=lf

# Never convert line endings in binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary

# .gitignore is LF, but its macOS "Icon" rule needs a literal carriage
# return in the pattern; store the file exactly as written
.gitignore -text

tests/			export-ignore
docs/images/	export-ignore
.github/		export-ignore
.gitignore		export-ignore
.gitattributes	export-ignore
phpunit.xml.*	export-ignore
build.xml		export-ignore
composer.lock	export-ignore
README.md		export-ignore
.editorconfig	export-ignore
